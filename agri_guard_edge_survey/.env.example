# Copy to .env (repo root or cwd when running `survey`) or export in shell.
#
# Backend API 根地址（无尾斜杠）：ping / sync / 菜单登录 共用。
# 优先读 SURVEY_*；未设置时可读 AGRI_GUARD_*（与仓库其它模块命名对齐）。
SURVEY_API_BASE_URL=http://127.0.0.1:8000
# AGRI_GUARD_API_BASE_URL=http://127.0.0.1:8000
# Same JWT as web (Authorization: Bearer)
SURVEY_API_TOKEN=

# Interactive menu (`survey` / `survey menu`): language zh | en; Enter accepts bracketed defaults
SURVEY_CLI_LANG=zh

# Defaults for menu prompts (optional; all can be overridden per run)
SURVEY_INPUT_DIR=
SURVEY_OUTPUT_DIR=
SURVEY_MODEL_PATH=
SURVEY_MISSION_NAME=
SURVEY_CONFIDENCE=0.5
SURVEY_TILE_SIZE=1024
SURVEY_OVERLAP=0.2
SURVEY_CLUSTER_EPS=0.5
SURVEY_DEVICE=auto
# 1/true/yes/是 -> on; 0/false/no/否 -> off
SURVEY_NO_L2=0
SURVEY_FORCE_PROCESS=0
SURVEY_VERBOSE=0
SURVEY_PING_TIMEOUT=15
SURVEY_LOCAL_MISSION_ID=
SURVEY_SYNC_DRY_RUN=0
SURVEY_SYNC_RETRIES=2
SURVEY_SYNC_FORCE=0
# Merge into existing cloud mission (optional); same as survey sync --target-mission-id
SURVEY_TARGET_MISSION_ID=
# Chunked sync: read timeout (seconds) for POST .../import/batch/session (large gzip manifest)
# SURVEY_BATCH_SESSION_TIMEOUT=900
# Default username for menu password-login path (optional)
SURVEY_LOGIN_USERNAME=
